# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL="mysql://root:password@localhost:3306/visumatch_db"

# JWT
JWT_SECRET=super-secret-jwt-key-visumatch-2024
JWT_EXPIRES_IN=7d

# Encryption key for API Configurations (AES-256-GCM requires 32-byte hex string: 64 hex characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AI Service
AI_SERVICE_URL=http://localhost:8001
INTERNAL_SERVICE_TOKEN=dev-internal-token
MOCK_AI=true

# Storage
STORAGE_ROOT=./data/storage

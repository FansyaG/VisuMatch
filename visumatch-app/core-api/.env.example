# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL="mysql://root:password@localhost:3306/visumatch_db"

# JWT
JWT_SECRET=super-secret-jwt-key-visumatch-2024
JWT_EXPIRES_IN=7d

# Encryption key for API Configurations (AES-256-GCM requires 32-byte hex string: 64 hex characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# SMTP Mailer
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
MAIL_FROM="VisuMatch <no-reply@visumatch.local>"

# Production Admin Seed (Optional in dev, used in prod)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@visumatch.local
ADMIN_PASSWORD=supersecurepassword123

# AI Service
AI_SERVICE_URL=http://localhost:8001
INTERNAL_SERVICE_TOKEN=dev-internal-token
MOCK_AI=true

# Storage
STORAGE_ROOT=./data/storage


# Host & Port
HOST=0.0.0.0
PORT=8001

# Security
INTERNAL_SERVICE_TOKEN=your-internal-service-token-here

# Storage Root (Path traversal protection)
STORAGE_ROOT=/data/storage

# STT Configuration
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default
MAX_CONCURRENT_TRANSCRIBE=2

# Testing & Mock Mode
MOCK_MODE=false
